#!/usr/bin/env python3
"""
Polls the Dexcom Share API for the latest glucose reading and prints a
single JSON object describing it. Called on an interval by the plugin's
Dexcom.qml bar widget.

Secrets (Dexcom Share username/password) live in a separate credentials
file, chmod 600, never checked into git and never passed as CLI args
(which would leak into `ps`). Everything else (thresholds, poll interval,
region) comes from CLI flags driven by the plugin's bar-widget settings.

Output shape (always valid JSON, even on failure):
{
  "ok": true,
  "mgdl": 112,
  "trendArrow": "→",
  "trendLabel": "Flat",
  "minutesAgo": 3,
  "status": "normal" | "low" | "high" | "urgent_low" | "urgent_high" | "stale",
  "tooltip": "112 mg/dL, steady - 3 min ago"
}
or on failure:
{ "ok": false, "error": "short reason", "tooltip": "full reason" }
"""
import argparse
import json
import math
import os
import re
import sys
import time
import urllib.error
import urllib.request

DEFAULT_CREDENTIALS_PATH = os.path.expanduser("~/.config/omarchy-dexcom/credentials.env")
SESSION_CACHE = os.path.expanduser("~/.cache/omarchy-dexcom-session.json")

# Public Dexcom Share application ids (not secrets - same ones every
# open-source Share client uses, e.g. pydexcom). Must match the region/server
# or authentication fails outright regardless of a correct password.
APPLICATION_ID_US = "d89443d2-327c-4a6f-89e5-496bbb0317db"
APPLICATION_IDS = {
    "share2": APPLICATION_ID_US,       # US
    "shareous1": APPLICATION_ID_US,    # outside US
    "share": "d8665ade-9673-4e27-9ff6-92db4ce13d13",  # Japan
}

TREND_ARROWS = {
    "DoubleUp": "⇈",
    "SingleUp": "↑",
    "FortyFiveUp": "↗",
    "Flat": "→",
    "FortyFiveDown": "↘",
    "SingleDown": "↓",
    "DoubleDown": "⇊",
    "NotComputable": "?",
    "RateOutOfRange": "?",
    "None": "?",
}

# Human-readable trend words, same wording pydexcom uses.
TREND_WORDS = {
    "DoubleUp": "rising quickly",
    "SingleUp": "rising",
    "FortyFiveUp": "rising slightly",
    "Flat": "steady",
    "FortyFiveDown": "falling slightly",
    "SingleDown": "falling",
    "DoubleDown": "falling quickly",
    "NotComputable": "unable to determine trend",
    "RateOutOfRange": "trend unavailable",
    "None": "unknown",
}

MMOL_L_PER_MGDL = 0.0555  # standard conversion factor (matches pydexcom)


def parse_bool(value):
    return str(value).strip().lower() in ("1", "true", "yes", "on")


def format_value(mgdl, units):
    if units == "mmol":
        return f"{round(mgdl * MMOL_L_PER_MGDL, 1):.1f}"
    return str(int(round(mgdl)))


def unit_label(units):
    return "mmol/L" if units == "mmol" else "mg/dL"


def parse_args():
    p = argparse.ArgumentParser()
    p.add_argument("--credentials", default=DEFAULT_CREDENTIALS_PATH)
    p.add_argument("--server", default="share2", choices=list(APPLICATION_IDS))
    p.add_argument("--low", type=int, default=70)
    p.add_argument("--high", type=int, default=180)
    p.add_argument("--urgent-low", type=int, default=55)
    p.add_argument("--urgent-high", type=int, default=250)
    p.add_argument("--stale-after", type=int, default=20)
    p.add_argument("--units", default="mgdl", choices=["mgdl", "mmol"])
    p.add_argument("--show-history", default="true")
    p.add_argument("--history-minutes", type=int, default=60)
    p.add_argument("--show-trend-word", default="false")
    p.add_argument("--graph-minutes", type=int, default=180)
    return p.parse_args()


def load_credentials(path):
    values = {}
    try:
        with open(path, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, val = line.partition("=")
                values[key.strip()] = val.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    return values


def fail(reason, tooltip=None):
    print(json.dumps({"ok": False, "error": reason, "tooltip": tooltip or reason}))
    sys.exit(0)


def server_base(server):
    return f"https://{server}.dexcom.com/ShareWebServices/Services"


def api_post(url, payload):
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "Accept-Encoding": "application/json",
            "User-Agent": "Dexcom Share/3.0.2.11",
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        return resp.read().decode("utf-8")


def api_post_checked(url, payload, step):
    try:
        body = api_post(url, payload)
    except urllib.error.HTTPError as e:
        detail = e.code
        try:
            err = json.loads(e.read().decode("utf-8"))
            detail = err.get("Code") or detail
        except Exception:
            pass
        fail(f"{step}_http_error", f"Dexcom {step} failed: {detail}")
    except urllib.error.URLError as e:
        fail(f"{step}_network_error", f"Dexcom {step} failed: {e.reason}")
    return body.strip().strip('"')


def login(creds, server):
    username = creds.get("DEXCOM_USERNAME")
    password = creds.get("DEXCOM_PASSWORD")
    if not username or not password:
        fail("no_credentials", "Set DEXCOM_USERNAME/DEXCOM_PASSWORD in the credentials file (see README)")

    app_id = APPLICATION_IDS[server]
    base = server_base(server)

    # Two-step flow matching the current Dexcom Share API (as used by
    # pydexcom): resolve accountName -> accountId, then accountId -> sessionId.
    account_id = api_post_checked(
        base + "/General/AuthenticatePublisherAccount",
        {"accountName": username, "password": password, "applicationId": app_id},
        "authenticate",
    )
    if not account_id or account_id == "00000000-0000-0000-0000-000000000000":
        fail("login_rejected", "Dexcom authentication rejected (bad username/password?)")

    session_id = api_post_checked(
        base + "/General/LoginPublisherAccountById",
        {"accountId": account_id, "password": password, "applicationId": app_id},
        "login",
    )
    if not session_id or session_id == "00000000-0000-0000-0000-000000000000":
        fail("login_rejected", "Dexcom login rejected (bad username/password?)")

    try:
        os.makedirs(os.path.dirname(SESSION_CACHE), exist_ok=True)
        with open(SESSION_CACHE, "w") as f:
            json.dump({"sessionId": session_id, "server": server, "ts": time.time()}, f)
        os.chmod(SESSION_CACHE, 0o600)
    except OSError:
        pass

    return session_id


def cached_session(server):
    try:
        with open(SESSION_CACHE, "r") as f:
            data = json.load(f)
        # Share sessions are long-lived; refresh proactively after 12h, and
        # never reuse a session cached for a different region/server.
        if data.get("server") == server and time.time() - data.get("ts", 0) < 12 * 3600:
            return data.get("sessionId")
    except (FileNotFoundError, ValueError, KeyError):
        pass
    return None


def fetch_readings(server, session_id, minutes=60, max_count=12):
    url = (
        server_base(server)
        + f"/Publisher/ReadPublisherLatestGlucoseValues?sessionId={session_id}&minutes={minutes}&maxCount={max_count}"
    )
    req = urllib.request.Request(
        url,
        data=b"",
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "Accept-Encoding": "application/json",
            "User-Agent": "Dexcom Share/3.0.2.11",
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.loads(resp.read().decode("utf-8"))


def parse_dotnet_date(value):
    match = re.search(r"Date\((\d+)", value)
    if not match:
        return None
    return int(match.group(1)) / 1000.0


def classify(mgdl, minutes_ago, args):
    if minutes_ago is not None and minutes_ago > args.stale_after:
        return "stale"
    if mgdl <= args.urgent_low:
        return "urgent_low"
    if mgdl <= args.low:
        return "low"
    if mgdl >= args.urgent_high:
        return "urgent_high"
    if mgdl >= args.high:
        return "high"
    return "normal"


def summarize_history(readings, units):
    values = [r.get("Value") for r in readings if isinstance(r.get("Value"), (int, float))]
    if len(values) < 2:
        return None

    lo, hi = min(values), max(values)
    newest, oldest = values[0], values[-1]  # API returns newest-first
    delta = newest - oldest

    # Direction wording stays keyed off the raw mg/dL delta regardless of
    # display units, so the +15 threshold means the same thing either way.
    if delta >= 15:
        direction = f"rising (+{format_value(abs(delta), units)} {unit_label(units)})"
    elif delta <= -15:
        direction = f"falling (-{format_value(abs(delta), units)} {unit_label(units)})"
    else:
        direction = "steady overall"

    span_minutes = 5 * (len(values) - 1)
    lo_s, hi_s = format_value(lo, units), format_value(hi, units)
    return f"Last {span_minutes} min: {lo_s}-{hi_s} {unit_label(units)} ({direction})"


def main():
    args = parse_args()
    show_history = parse_bool(args.show_history)
    show_trend_word = parse_bool(args.show_trend_word)

    creds = load_credentials(args.credentials)
    if not creds:
        fail("no_credentials", f"Create {args.credentials} (chmod 600) - see README")

    # Fetch enough history to cover both the tooltip's summary window and the
    # popup graph's window - one API call serves both, no extra requests.
    window = max(15, args.graph_minutes, args.history_minutes if show_history else 0)
    max_count = min(288, max(2, math.ceil(window / 5) + 1))

    session_id = cached_session(args.server)
    readings = None
    for attempt in range(2):
        if not session_id:
            session_id = login(creds, args.server)
        try:
            readings = fetch_readings(args.server, session_id, minutes=window, max_count=max_count)
            break
        except urllib.error.HTTPError as e:
            if e.code in (500, 401) and attempt == 0:
                # Likely an expired/invalid session; force a fresh login once.
                session_id = None
                continue
            fail("fetch_http_error", f"Dexcom read failed: HTTP {e.code}")
        except urllib.error.URLError as e:
            fail("fetch_network_error", f"Dexcom read failed: {e.reason}")

    if not readings:
        fail("no_data", "No recent Dexcom readings")

    latest = readings[0]
    mgdl = latest.get("Value")
    trend = str(latest.get("Trend", "None"))
    wt = latest.get("WT") or latest.get("ST") or latest.get("DT") or ""
    reading_ts = parse_dotnet_date(wt)

    seconds_ago = None
    minutes_ago = None
    if reading_ts is not None:
        seconds_ago = max(0, int(time.time() - reading_ts))
        minutes_ago = seconds_ago // 60

    status = classify(mgdl, minutes_ago, args)
    arrow = TREND_ARROWS.get(trend, "?")
    display_value = format_value(mgdl, args.units)
    unit = unit_label(args.units)
    trend_text = TREND_WORDS.get(trend, trend) if show_trend_word else trend

    age_text = f"{minutes_ago} min ago" if minutes_ago is not None else "time unknown"
    tooltip = f"{display_value} {unit}, {trend_text} - {age_text}"
    if status == "stale":
        tooltip = f"Last reading {age_text}: {display_value} {unit} (sensor may be disconnected)"
    elif show_history:
        history_line = summarize_history(readings, args.units)
        if history_line:
            tooltip += "\n" + history_line

    series = []
    now = time.time()
    for r in readings:
        v = r.get("Value")
        if not isinstance(v, (int, float)):
            continue
        ts = parse_dotnet_date(r.get("WT") or r.get("ST") or r.get("DT") or "")
        series.append(
            {
                "secondsAgo": max(0, int(now - ts)) if ts is not None else None,
                "raw": v,
                "value": float(format_value(v, args.units)),
            }
        )
    series.reverse()  # oldest first, natural left-to-right plotting

    print(
        json.dumps(
            {
                "ok": True,
                "mgdl": display_value,
                "unit": unit,
                "trendArrow": arrow,
                "trendLabel": trend,
                "minutesAgo": minutes_ago,
                "secondsAgo": seconds_ago,
                "status": status,
                "tooltip": tooltip,
                "series": series,
                "thresholds": {
                    "low": float(format_value(args.low, args.units)),
                    "high": float(format_value(args.high, args.units)),
                    "urgentLow": float(format_value(args.urgent_low, args.units)),
                    "urgentHigh": float(format_value(args.urgent_high, args.units)),
                },
            }
        )
    )


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # last-resort guard so the bar never sees a crash
        fail("unexpected_error", f"dexcom-status crashed: {e}")
